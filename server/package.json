{
  "name": "supersurf-mcp",
  "mcpName": "io.github.LiquidBuiltIt/supersurf-mcp",
  "version": "3.3.0",
  "description": "Open-source MCP server for browser automation — gives AI agents control of a real Chrome browser via extension",
  "main": "dist/bin/supersurf.js",
  "types": "dist/bin/supersurf.d.ts",
  "bin": {
    "supersurf": "dist/bin/supersurf.js",
    "supersurf-mcp": "dist/bin/supersurf-mcp.js",
    "supersurf-daemon": "dist/bin/supersurf-daemon.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "Apache-2.0",
  "author": "The Media Masons",
  "repository": {
    "type": "git",
    "url": "https://github.com/liquidbuiltit/Supersurf.git",
    "directory": "server"
  },
  "homepage": "https://liquidbuiltit.github.io/Supersurf",
  "bugs": {
    "url": "https://github.com/liquidbuiltit/Supersurf/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser-automation",
    "web-automation",
    "ai-agent",
    "chrome-extension",
    "claude",
    "llm",
    "puppeteer-alternative",
    "playwright-alternative",
    "anthropic",
    "automation",
    "supersurf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && npx tsx ../scripts/shared.bundle.ts server && chmod +x dist/bin/supersurf.js dist/bin/supersurf-mcp.js dist/bin/supersurf-daemon.js",
    "prepublishOnly": "cp ../LICENSE . && npm run clean && npm run build",
    "dev": "npx tsx src/cli.ts --debug",
    "test": "vitest run",
    "test.watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "commander": "^14.0.1",
    "image-size": "^2.0.2",
    "jsonpath-plus": "^10.3.0",
    "sharp": "^0.34.5",
    "supersurf-daemon": "^3.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "shared": "*",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
